# ==============================================================================
# Capacitação inclu — Variáveis de Ambiente
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/inclu_capacitacao?schema=public"

# Next.js & NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="chave-secreta-desenvolvimento-inclu-capacitacao-2026"

# GitLab OAuth App (https://gitlab.com/-/profile/applications)
# Escopos necessários: read_user, api
GITLAB_CLIENT_ID="mock-gitlab-client-id"
GITLAB_CLIENT_SECRET="mock-gitlab-client-secret"

# GitLab Bot Account Token (Mentor Bot @ej-mentor-bot para a Trilha 2)
# Personal Access Token com escopo 'api'
GITLAB_BOT_TOKEN="mock-gitlab-bot-token"

# Namespace / Grupo opcional para os repositórios de treino da Trilha 2
# Se vazio, cria no namespace do próprio usuário
GITLAB_TRAINING_GROUP_ID=""

# Modo Mock para testes e desenvolvimento offline sem internet/GitLab
ENABLE_GITLAB_MOCK="true"

# CLI Backend API Base URL
CLI_BACKEND_URL="http://localhost:3000"
