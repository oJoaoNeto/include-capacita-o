# ==============================================================================
# Capacitação inclu — Configuração de Ambiente para Produção (.env.production)
# ==============================================================================

# 1. Banco de Dados PostgreSQL (Produção)
# Se estiver usando o docker-compose.prod.yml, o host é 'postgres'
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="gere-uma-senha-forte-para-o-banco-aqui"
POSTGRES_DB="inclu_capacitacao"
DATABASE_URL="postgresql://postgres:gere-uma-senha-forte-para-o-banco-aqui@postgres:5432/inclu_capacitacao?schema=public"

# 2. NextAuth.js (Sessão & Segurança)
# URL pública do domínio onde a aplicação web responderá com HTTPS
NEXTAUTH_URL="https://capacitacao.sua-ej.com.br"

# Chave secreta de alta entropia. Gere no terminal com: openssl rand -base64 32
NEXTAUTH_SECRET="substitua-com-openssl-rand-base64-32"

# 3. Integração com GitLab OAuth 2.0 (Autenticação dos Trainees e Membros)
# Crie uma aplicação em: https://gitlab.com/-/profile/applications
# - Name: Capacitação inclu
# - Redirect URI: https://capacitacao.sua-ej.com.br/api/auth/callback/gitlab
# - Scopes: read_user, api
GITLAB_CLIENT_ID="seu-gitlab-application-id"
GITLAB_CLIENT_SECRET="seu-gitlab-application-secret"

# 4. Token do Mentor Bot (@ej-mentor-bot para a Trilha 2)
# Crie um Personal Access Token com escopo 'api' na conta do bot da EJ
GITLAB_BOT_TOKEN="glpat-token-do-bot-da-empresa-junior"

# Namespace / Grupo opcional da EJ onde os repositórios de treino serão alocados
# Deixe vazio para criar diretamente sob a conta do próprio aluno
GITLAB_TRAINING_GROUP_ID=""

# 5. Flags Operacionais
# Em produção, defina ambas como 'false'
ENABLE_GITLAB_MOCK="false"
ENABLE_DEMO_AUTH="false"

# 6. URL Base do Backend para a CLI ej-cap
CLI_BACKEND_URL="https://capacitacao.sua-ej.com.br"
